<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Document</title>
  </head>
  <body>
    <main>
      <form action="/user/api/tasks/" method="post" id="task-form">
        <input
          type="text"
          name="title"
          id="title"
          placeholder="Wake Up 6AM"
          required
        />
        <textarea
          name="description"
          id="description"
          placeholder="(optional)"
        ></textarea>
        <select name="status" id="status">
          <option value="todo">todo</option>
          <option value="in-progres">in-progres</option>
          <option value="done">done</option>
        </select>
        <input type="date" name="dueDate" id="dueDate" required />
        <input type="date" name="createdAt" id="createdAt" required />

        <button class="addBtn" type="submit">Add</button>
      </form>

      <div class="content-display">
        <!-- <h1>Display Tasks</h1> -->
        <form
          action="/user/api/tasks/json-data/"
          method="post"
          id="search-form"
        >
          <input type="search" name="search" id="search-field" />
          <button>Search</button>
        </form>
        <ul id="task-list"></ul>
      </div>
    </main>

    <script src="/main.js"></script>
  </body>
</html>
